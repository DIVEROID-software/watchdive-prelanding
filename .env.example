# Waitlist storage (server-only)
NOTION_API_KEY=
NOTION_WAITLIST_DB_ID=

# Meta conversion tracking (email signup = Lead)
# Dataset id from Events Manager ("WatchDive data set" → settings). The same id
# is needed twice: VITE_ prefix exposes it to the browser pixel; the bare one
# stays server-side for the Conversions API.
VITE_META_TRACKING_ENABLED=false
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# CAPI remains off unless this, the browser gate, matching numeric ids, and the
# access token are all configured.
META_CAPI_ENABLED=false
# Conversions API access token: Events Manager → dataset → 설정 → Conversions API → 토큰 생성
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing so events appear under Test Events, then remove.
META_CAPI_TEST_EVENT_CODE=

# Durable, server-only funnel measurement store. Keep the service-role key
# exclusively in server environments; no browser receives it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public waitlist abuse protection and PII-free canonical lead ownership
# (server-only). Use an independent random secret of at least 32 characters.
# Supabase receives only keyed HMACs, never raw client addresses or emails.
# Keep this key stable: rotation requires an explicit canonical-claim migration.
# Production fails closed if this protection is not configured.
SIGNUP_RATE_LIMIT_HMAC_SECRET=
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=120

# Private operations dashboard (/ops/funnel)
FUNNEL_DASHBOARD_TOKEN=

# Meta Marketing API insights sync (server-only, ads_read).
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=727396218766985
META_CAMPAIGN_IDS=120251217895480717,120251245570880717
# Every synced campaign must be in exactly one conversion-location allowlist.
# This keeps zero-lead spend assigned to the correct Website vs Instant Form path.
META_WEBSITE_CAMPAIGN_IDS=120251217895480717
META_INSTANT_FORM_CAMPAIGN_IDS=120251245570880717

# Meta Instant Form leadgen webhook and Graph lead retrieval.
META_GRAPH_API_VERSION=v26.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=102850088374205
# Form allowlist is mandatory because the Page may own unrelated lead forms.
# Campaign allowlist is an optional second gate checked after Graph retrieval.
# Both values are comma-separated IDs.
META_LEADGEN_FORM_IDS=1735092254406802
META_LEADGEN_CAMPAIGN_IDS=120251245570880717
# Optional exact Instant Form country attribution keyed by Meta ad set id.
# Example: {"120251...":"US","120252...":"GB"}
META_ADSET_COUNTRY_MAP={}

# PII-free email/SMS verification result webhook (/api/funnel/lead-status).
LEAD_STATUS_WEBHOOK_SECRET=
