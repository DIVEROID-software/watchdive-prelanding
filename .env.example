# Waitlist storage (server-only)
NOTION_API_KEY=
NOTION_WAITLIST_DB_ID=

# Email confirmation (server-only). One transactional message per Claim — no
# audience, no list state, no webhooks. The confirmation link is built from
# WATCHDIVE_PUBLIC_ORIGIN, never from a request Host header.
RESEND_API_KEY=
# Verified sender, e.g. "Watch Dive <hello@watchdive.diveroid.com>"
WATCHDIVE_EMAIL_FROM=
# Optional.
WATCHDIVE_EMAIL_REPLY_TO=
# Fixed https origin, no path or query, e.g. https://watchdive.diveroid.com
WATCHDIVE_PUBLIC_ORIGIN=
# Minimum 32 bytes. Signs confirmation tokens, poll handles, and the
# deterministic Meta event id. Rotating it invalidates every link in flight.
WATCHDIVE_VERIFICATION_SECRET=

# Internal translation review only. Non-English product claims stay unreachable
# unless a deliberately configured preview build sets the exact value `true`.
VITE_WATCHDIVE_I18N_REVIEW=false

# Separate internal gate for the unverified compatibility, sensor/Bluetooth and
# battery/service FAQ copy. Enabling locales must never enable these claims.
VITE_WATCHDIVE_PRODUCT_CLAIMS_REVIEW=false

# Meta conversion tracking (email signup = Lead)
# Dataset id from Events Manager ("WatchDive data set" → settings). The same id
# is needed twice: VITE_ prefix exposes it to the browser pixel; the bare one
# stays server-side for the Conversions API.
VITE_META_TRACKING_ENABLED=false
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# CAPI remains off unless this, the browser gate, matching numeric ids, and the
# access token are all configured.
META_CAPI_ENABLED=false
# Conversions API access token: Events Manager → dataset → 설정 → Conversions API → 토큰 생성
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing so events appear under Test Events, then remove.
META_CAPI_TEST_EVENT_CODE=
