# Waitlist storage (server-only)
NOTION_API_KEY=
NOTION_WAITLIST_DB_ID=
# Optional. Name of a rich_text column in the waitlist DB (e.g. FBCLID) that
# receives the Meta click id. Leave empty until that column exists: writing an
# unknown property makes Notion reject the whole row. UTM source/medium/
# campaign/content/term and Landing path are always written.
NOTION_FBCLID_PROPERTY=

# Page-behaviour summaries (server-only, same NOTION_API_KEY). One row per
# measured session: Name (title); Locale, Device, Country, Timezone, Viewport,
# Referrer, Campaign, Sections, Clicks (text); Duration, Scroll (number).
# Either id works: the database id (32 hex characters in the database's own
# URL, notion.so/<workspace>/<id>?v=..., not the ?v= view id and not the id of
# a page that merely embeds the database), or its data-source id ("Copy data
# source ID", or the collection:// id). The integration behind NOTION_API_KEY
# must be added to the database itself (••• → Connections). A failed write
# logs one line starting "[page-behavior] write failed" with Notion's status,
# code and message (ids removed).
NOTION_UX_DB_ID=

# Email confirmation (server-only). One transactional message per Claim — no
# audience, no list state, no webhooks. The confirmation link is built from
# WATCHDIVE_PUBLIC_ORIGIN, never from a request Host header.
RESEND_API_KEY=
# Verified sender address, e.g. "verify@mail.oceanwick.ai" (the domain must be
# verified in Resend). Any display name here is replaced by the one below.
WATCHDIVE_EMAIL_FROM=
# Optional inbox display name. Defaults to "DIVEROID".
WATCHDIVE_EMAIL_FROM_NAME=
# Optional.
WATCHDIVE_EMAIL_REPLY_TO=
# Fixed https origin, no path or query, e.g. https://watchdive.diveroid.com
WATCHDIVE_PUBLIC_ORIGIN=
# Minimum 32 bytes. Signs confirmation tokens, poll handles, and the
# deterministic Meta event id. Rotating it invalidates every link in flight.
WATCHDIVE_VERIFICATION_SECRET=

# Internal translation review only. Non-English product claims stay unreachable
# unless a deliberately configured preview build sets the exact value `true`.
VITE_WATCHDIVE_I18N_REVIEW=false

# Meta conversion tracking. `Lead` fires at the accepted form submit (browser
# pixel + Conversions API, same event_id); the confirmation click sends the
# custom `EmailVerified`. Outside EU/EEA/UK/CH the pixel loads by default;
# inside, or with an unknown country, only after Allow (see consentRegion.ts).
# Dataset id from Events Manager ("WatchDive data set" → settings). The same id
# is needed twice: VITE_ prefix exposes it to the browser pixel; the bare one
# stays server-side for the Conversions API.
VITE_META_TRACKING_ENABLED=false
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# CAPI remains off unless this, the browser gate, matching numeric ids, and the
# access token are all configured.
META_CAPI_ENABLED=false
# Conversions API access token: Events Manager → dataset → 설정 → Conversions API → 토큰 생성
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing so events appear under Test Events, then remove.
META_CAPI_TEST_EVENT_CODE=

# Google tags. Both stay off until the id is set. They follow the same regional
# rule as the Meta pixel (opt-in in EU/EEA/UK/CH or unknown country, default-on
# elsewhere; "Not now" or Global Privacy Control always off). No tag is
# injected on /verify.
# GA4 measurement id, e.g. G-XXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity project id. Heatmaps load only after Allow.
VITE_CLARITY_PROJECT_ID=
# Google Ads: leave empty until the platform owner verifies the ID and labels
# belong to the current account 139-796-0411. A customer ID is not an AW tag ID.
# Do not reuse the earlier unverified account defaults.
VITE_GOOGLE_ADS_ID=
# Historical confirmed-email conversion only (trackGoogleLead). That label was not
# one of the two website actions created on 2026-10-26. Leave it blank.
VITE_GOOGLE_ADS_CONVERSION_LABEL=
# Verified email signup: first CompleteRegistration (email link or authoritative social).
# This is not the raw form Lead. transaction_id is the CompleteRegistration event id.
VITE_GOOGLE_ADS_SIGNUP_LABEL=
# Stripe-confirmed USD 3 reservation. Action "WatchDive $3 Reservation"
# (count every, value 3 USD, primary, account default).
# transaction_id is the Purchase event id. event time is Charge.created.
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# Consented server completion measurement: local integration only, disabled.
# Review GA4 import versus direct Ads actions to avoid optimizing the same
# action twice. Public/server GA4 switches must be enabled together.
WATCHDIVE_GA4_CONVERSIONS_ENABLED=false
VITE_GA4_SERVER_CONVERSIONS_ENABLED=false
GA4_API_SECRET=
# Independent of GA4; reuses the existing Meta CAPI flags/IDs/token above.
WATCHDIVE_META_PURCHASE_ENABLED=false
# Approved durable Redis-compatible REST ledger, not Notion or process memory.
# No automatic eviction of event claims. Existing verification secret signs keys.
WATCHDIVE_CONVERSION_REDIS_REST_URL=
WATCHDIVE_CONVERSION_REDIS_REST_TOKEN=
# Public ledger epoch, 16-80 characters [A-Za-z0-9._:-]. Not a credential.
# Leave empty until root runs scripts/conversion-ledger-init.ts once.
# Runtime never creates this marker. A missing value keeps the senders off.
WATCHDIVE_CONVERSION_LEDGER_EPOCH=

# Local development only: pretend the visitor is in this country (e.g. US or
# DE) when there is no x-vercel-ip-country header. Ignored on Vercel.
WATCHDIVE_DEV_GEO_COUNTRY=

# Stable mobile form-first experiment; aggregate report is private.
VITE_CONVERSION_EXPERIMENT_ENABLED=false
WATCHDIVE_EXPERIMENT_REPORT_TOKEN=
