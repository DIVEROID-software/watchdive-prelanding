# Waitlist storage (server-only)
NOTION_API_KEY=
NOTION_WAITLIST_DB_ID=

# Email confirmation (server-only). One transactional message per Claim — no
# audience, no list state, no webhooks. The confirmation link is built from
# WATCHDIVE_PUBLIC_ORIGIN, never from a request Host header.
RESEND_API_KEY=
# Verified sender, e.g. "Watch Dive <hello@watchdive.diveroid.com>"
WATCHDIVE_EMAIL_FROM=
# Optional.
WATCHDIVE_EMAIL_REPLY_TO=
# Fixed https origin, no path or query, e.g. https://watchdive.diveroid.com
WATCHDIVE_PUBLIC_ORIGIN=
# Minimum 32 bytes. Signs confirmation tokens, poll handles, and the
# deterministic Meta event id. Rotating it invalidates every link in flight.
WATCHDIVE_VERIFICATION_SECRET=

# Internal translation review only. Non-English product claims stay unreachable
# unless a deliberately configured preview build sets the exact value `true`.
VITE_WATCHDIVE_I18N_REVIEW=false

# Meta conversion tracking (email signup = Lead)
# Dataset id from Events Manager ("WatchDive data set" → settings). The same id
# is needed twice: VITE_ prefix exposes it to the browser pixel; the bare one
# stays server-side for the Conversions API.
VITE_META_TRACKING_ENABLED=false
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# CAPI remains off unless this, the browser gate, matching numeric ids, and the
# access token are all configured.
META_CAPI_ENABLED=false
# Conversions API access token: Events Manager → dataset → 설정 → Conversions API → 토큰 생성
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing so events appear under Test Events, then remove.
META_CAPI_TEST_EVENT_CODE=

# LaunchOS first-party funnel measurement. Both master gates remain false until
# every value below is provisioned and the Notion database has a rich_text
# property named exactly `LaunchOS replay metadata`.
VITE_LAUNCHOS_MEASUREMENT_CONSENT_UI_ENABLED=false
LAUNCHOS_MEASUREMENT_ENABLED=false
LAUNCHOS_NOTION_REPLAY_ENABLED=false
# Keeps withdrawal fail-closed until the dedicated privacy key and bounded
# LaunchOS purge worker have passed their activation canary.
LAUNCHOS_WITHDRAWAL_ENABLED=false
# Bare HTTPS origin of the owner-private LaunchOS console.
LAUNCHOS_BASE_URL=
# Copy the exact sealed identifiers from LaunchOS. Deliberately blank: these
# are not safe defaults and a placeholder must never pass production preflight.
LAUNCHOS_PROJECT_ID=
LAUNCHOS_FUNNEL_VERSION=
# production | preview | development
LAUNCHOS_ENVIRONMENT=production

# Four distinct source-scoped credentials from the LaunchOS key registry.
LAUNCHOS_WEB_EVENTS_INGRESS_KEY_ID=
LAUNCHOS_WEB_EVENTS_INGRESS_SECRET=
LAUNCHOS_LEAD_STORE_INGRESS_KEY_ID=
LAUNCHOS_LEAD_STORE_INGRESS_SECRET=
LAUNCHOS_VERIFICATION_INGRESS_KEY_ID=
LAUNCHOS_VERIFICATION_INGRESS_SECRET=
# Dedicated privacy credential; do not reuse any event/import credential.
LAUNCHOS_WITHDRAWAL_INGRESS_KEY_ID=
LAUNCHOS_WITHDRAWAL_INGRESS_SECRET=

# Distinct secrets, minimum 32 bytes. WAITLIST_REPLAY_HMAC_SECRET is the exact
# durable replay/cookie authority asset name; do not create an alias for it.
LAUNCHOS_CANONICAL_LEAD_HMAC_SECRET=
WAITLIST_REPLAY_HMAC_SECRET=
LAUNCHOS_QUALITY_RULE_VERSION=
LAUNCHOS_VERIFICATION_POLICY_VERSION=
# Exact numeric campaign/adset/ad triples automatically generated from Meta.
LAUNCHOS_APPROVED_META_IDENTITY_REGISTRY_JSON=[]
# Required only when LAUNCHOS_BASE_URL is a private *.chatgpt.site site.
LAUNCHOS_SITES_BEARER_TOKEN=

# Bounded direct delivery: both source batches run in parallel. Defaults cap a
# relay attempt at 1.2s and retry once (worst-case ~2.55s), while email delivery
# starts concurrently after the authoritative Notion commit.
LAUNCHOS_RELAY_TIMEOUT_MS=1200
LAUNCHOS_RELAY_MAX_ATTEMPTS=2
