# PREPARATION ONLY. Do not activate before owner approval of all localized push copy,
# VAPID ownership, the dedicated Notion database, retention, edge rate limiting and an
# explicit send. Values stay empty in the repo. See src/lib/push/RUNBOOK.md.
WATCHDIVE_PUSH_ENABLED=false
WATCHDIVE_PUSH_COPY_APPROVED=
WATCHDIVE_PUSH_VAPID_PUBLIC_KEY=
WATCHDIVE_PUSH_VAPID_PRIVATE_KEY=
WATCHDIVE_PUSH_VAPID_SUBJECT=
WATCHDIVE_PUSH_RECEIPT_SECRET=
# file is the non-serverless operator volume. Production serverless uses notion.
WATCHDIVE_PUSH_STORE=
WATCHDIVE_PUSH_STORE_DIR=
WATCHDIVE_PUSH_NOTION_TOKEN=
WATCHDIVE_PUSH_NOTION_DB_ID=
WATCHDIVE_PUSH_ENCRYPTION_SECRET=
WATCHDIVE_PUSH_SEND_ENABLED=
WATCHDIVE_PUSH_RETENTION_DAYS=
# Fixed existing canonical HTTPS origin; never derive from a request host.
WATCHDIVE_PUBLIC_ORIGIN=https://watchdive.diveroid.com
# Public key is the only key exposed to browsers. No scheduler is installed.
# File store requires a persistent volume. Serverless ephemeral disk cannot enroll.
